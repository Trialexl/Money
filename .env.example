APP_DOMAIN=money.example.com
HTTP_PORT=80
HTTPS_PORT=443

SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=money.example.com
CSRF_TRUSTED_ORIGINS=https://money.example.com
CORS_ALLOWED_ORIGINS=https://money.example.com
CORS_ALLOW_CREDENTIALS=True
USE_X_FORWARDED_HOST=True
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
AUTH_COOKIE_SECURE=True
AUTH_COOKIE_SAMESITE=Lax

DB_NAME=money
DB_USER=money
DB_PASSWORD=change-me
DB_PORT=5432

NEXT_PUBLIC_API_URL=/api/v1

DB_MEMORY_LIMIT=768m
DB_MEMORY_RESERVATION=256m
DB_PIDS_LIMIT=256
BACKEND_MEMORY_LIMIT=768m
BACKEND_MEMORY_RESERVATION=256m
BACKEND_PIDS_LIMIT=256
FRONTEND_MEMORY_LIMIT=512m
FRONTEND_MEMORY_RESERVATION=128m
FRONTEND_PIDS_LIMIT=128
FRONTEND_NODE_OPTIONS=--max-old-space-size=256
CADDY_MEMORY_LIMIT=128m
CADDY_MEMORY_RESERVATION=32m
CADDY_PIDS_LIMIT=128
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=5

BACKUP_RETENTION_DAYS=30
BACKUP_DIR=/app/backups/postgres
BACKUP_LOG_DIR=/app/backups/logs
BACKUP_MIN_BYTES=1024
BACKUP_UPLOAD_AFTER_CREATE=true
# Configure exactly one off-server target for ./backup-db.sh sync.
BACKUP_REMOTE_DIR=
BACKUP_RCLONE_REMOTE=
BACKUP_RSYNC_TARGET=
BACKUP_SCP_TARGET=
BACKUP_ALERT_WEBHOOK_URL=
SCHEDULED_JOBS_ALERT_WEBHOOK_URL=
SCHEDULED_JOBS_MARKET_MAX_AGE_DAYS=2

GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=180
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_MAX_REQUESTS=500
GUNICORN_MAX_REQUESTS_JITTER=50

CREATE_SUPERUSER=False
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

AI_DEFAULT_PROVIDER=openrouter
AI_OPENROUTER_API_KEY=
AI_OPENROUTER_MODEL=google/gemini-2.5-flash
AI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
AI_OPENROUTER_SITE_URL=https://money.example.com
AI_OPENROUTER_APP_NAME=money
AI_OPENAI_API_KEY=
AI_OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
AI_OPENAI_TRANSCRIBE_BASE_URL=https://api.openai.com/v1/audio/transcriptions
AI_OPENAI_TRANSCRIBE_LANGUAGE=ru
AI_OPENAI_TRANSCRIBE_PROMPT=
AI_ALLOW_RULE_BASED_FALLBACK=True
AI_TELEGRAM_BOT_SECRET=
AI_TELEGRAM_BOT_TOKEN=
AI_TELEGRAM_API_BASE_URL=https://api.telegram.org
AI_DUPLICATE_WINDOW_SECONDS=600

INVESTMENT_PRICE_PROVIDER=auto
INVESTMENT_PRICE_PROVIDER_TIMEOUT=10
INVESTMENT_FX_PROVIDER=cbr
INVESTMENT_FX_PROVIDER_TIMEOUT=10
