      responses:
        '200':
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AiAssistantResponse'
          description: ''
  /api/v1/auth/logout/:
    post:
      operationId: v1_auth_logout_create
      description: Выход из системы с добавлением токена в blacklist
      tags:
