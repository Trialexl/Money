components:
  schemas:
    AiAssistantBalanceRow:
      type: object
      properties:
        wallet_id:
          type: string
          format: uuid
        wallet_name:
          type: string
        balance:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
      required:
      - balance
      - wallet_id
      - wallet_name
    AiAssistantCreatedObject:
      type: object
      properties:
        model:
          type: string
        id:
          type: string
          format: uuid
        number:
          type: string
      required:
      - id
      - model
      - number
    AiAssistantExecuteRequest:
      type: object
      properties:
        text:
          type: string
        image:
          type: string
          format: binary
        wallet:
          type: string
          format: uuid
        dry_run:
          type: boolean
          default: false
    AiAssistantMissingFieldByItem:
      type: object
      properties:
        index:
          type: integer
        missing_fields:
          type: array
          items:
            type: string
      required:
      - index
      - missing_fields
    AiAssistantResponse:
      type: object
      properties:
        status:
          $ref: '#/components/schemas/AiAssistantResponseStatusEnum'
        intent:
          type: string
        provider:
          type: string
        confidence:
          type: number
          format: double
        reply_text:
          type: string
        reply_parse_mode:
          type: string
        missing_fields:
          type: array
          items:
            type: string
        missing_fields_by_item:
          type: array
          items:
            $ref: '#/components/schemas/AiAssistantMissingFieldByItem'
        created_object:
          $ref: '#/components/schemas/AiAssistantCreatedObject'
        created_objects:
          type: array
          items:
            $ref: '#/components/schemas/AiAssistantCreatedObject'
        preview:
          type: object
          additionalProperties: {}
        balances:
          type: array
          items:
            $ref: '#/components/schemas/AiAssistantBalanceRow'
        expense_summary:
          type: object
          additionalProperties: {}
        options:
          type: object
          additionalProperties: {}
        parsed:
          type: object
          additionalProperties: {}
      required:
      - confidence
      - intent
      - provider
      - reply_text
      - status
    AiAssistantResponseStatusEnum:
      enum:
      - created
      - preview
      - needs_confirmation
      - balance
      - duplicate
      - info
      type: string
      description: |-
        * `created` - created
        * `preview` - preview
        * `needs_confirmation` - needs_confirmation
        * `balance` - balance
        * `duplicate` - duplicate
        * `info` - info
    AiAssistantTelegramWebhookRequest:
      type: object
      properties:
        update_id:
          type: integer
        message:
          type: object
          additionalProperties: {}
        edited_message:
          type: object
          additionalProperties: {}
    AmountCurrencyEnum:
      enum:
      - USD
      - EUR
      - RUB
      type: string
      description: |-
        * `USD` - USD
        * `EUR` - EUR
        * `RUB` - RUB
    AutoPayment:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        graphic_contract:
          type: object
          additionalProperties: {}
          readOnly: true
        number:
          type: string
          readOnly: true
        date:
          type: string
          format: date-time
        date_start:
          type: string
          format: date-time
          description: Alias next_date не поддерживается.
        deleted:
          type: boolean
        posted:
          type: boolean
        is_transfer:
          type: boolean
        amount_month:
          type: integer
          maximum: 2147483647
          minimum: -2147483648
          description: Alias period_days не поддерживается.
        amount:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
        comment:
          type: string
          maxLength: 200
        wallet_in:
          type: string
          format: uuid
          nullable: true
        wallet_out:
          type: string
          format: uuid
          nullable: true
        cash_flow_item:
          type: string
          format: uuid
          nullable: true
      required:
      - amount
      - graphic_contract
      - id
      - number
    AutoPaymentGraphic:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        date_start:
          type: string
          format: date-time
        amount:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
        document:
          type: string
          format: uuid
      required:
      - amount
      - document
      - id
    AutoPaymentGraphicRequest:
      type: object
      properties:
        date_start:
          type: string
          format: date-time
        amount:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
        document:
          type: string
          format: uuid
      required:
