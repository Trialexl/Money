          type: integer
        total_balance:
          type: number
          format: double
      required:
      - balances
      - total_balance
      - total_wallets
    WalletRequest:
      type: object
      properties:
        name:
          type: string
          nullable: true
          minLength: 1
          maxLength: 25
        deleted:
          type: boolean
        hidden:
          type: boolean
    WalletSummaryOperation:
      type: object
      properties:
        id:
          type: string
          format: uuid
        kind:
          $ref: '#/components/schemas/WalletSummaryOperationKindEnum'
        date:
          type: string
          format: date-time
        amount:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
        description:
          type: string
          nullable: true
      required:
      - amount
      - date
      - id
      - kind
    WalletSummaryOperationKindEnum:
      enum:
      - receipt
      - expenditure
      type: string
      description: |-
        * `receipt` - receipt
        * `expenditure` - expenditure
    WalletSummaryResponse:
      type: object
      properties:
        wallet_id:
          type: string
          format: uuid
        wallet_name:
          type: string
        balance:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
        income_total:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
        expense_total:
          type: string
          format: decimal
          pattern: ^-?\d{0,10}(?:\.\d{0,2})?$
        recent_operations:
          type: array
          items:
            $ref: '#/components/schemas/WalletSummaryOperation'
      required:
      - balance
      - expense_total
      - income_total
      - recent_operations
      - wallet_id
      - wallet_name
  securitySchemes:
    cookieAuth:
      type: apiKey
      in: cookie
      name: sessionid
    jwtAuth:
      type: http
      scheme: bearer
      bearerFormat: JWT
    tokenAuth:
      type: apiKey
      in: header
      name: Authorization
      description: Token-based authentication with required prefix "Token"
